{
  "manifest_version": 3,
  "name": "SafeVault",
  "version": "0.1.0",
  "description": "Fill your SafeVault logins in Chrome. Read-only: your vault is decrypted locally with your master password.",
  "key": "",
  "minimum_chrome_version": "116",
  "action": { "default_title": "SafeVault", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "permissions": ["storage", "alarms", "identity", "activeTab", "scripting"],
  "host_permissions": ["https://api.dropboxapi.com/*", "https://content.dropboxapi.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; connect-src https://api.dropboxapi.com https://content.dropboxapi.com" }
}
